<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFF8F0">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="知学"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FF6B35"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="快乐识字，轻松启蒙"
        android:textSize="14sp"
        android:textColor="#999999"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="学习进度"
        android:textSize="18sp"
        android:textColor="#333333"
        android:textStyle="bold"/>

    <ProgressBar
        android:id="@+id/progress_learning"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:progressTint="#FF6B35"
        android:progressBackgroundTint="#E0E0E0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tv_learned_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FF6B35"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" / "
            android:textSize="18sp"
            android:textColor="#999999"/>

        <TextView
            android:id="@+id/tv_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="87"
            android:textSize="18sp"
            android:textColor="#999999"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 字"
            android:textSize="18sp"
            android:textColor="#999999"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_today_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今天继续加油！"
        android:textSize="16sp"
        android:textColor="#666666"
        android:padding="16dp"
        android:background="@drawable/card_bg"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日推荐"
        android:textSize="18sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_characters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <Button
        android:id="@+id/btn_start_learning"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="开始学习"
        android:textSize="18sp"
        android:backgroundTint="#FF6B35"
        android:textColor="@color/white"
        android:layout_marginTop="8dp"/>

</LinearLayout>
